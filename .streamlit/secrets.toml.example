# Copie este archivo a `.streamlit/secrets.toml` en su máquina o configure
# las mismas claves en el panel de secretos de Streamlit Cloud.
# NO suba `secrets.toml` ni JSON de Firebase al repositorio.

# --- Persistencia: sqlite | firestore | auto (recomendado en local sin Firebase) ---
# IDSML_PERSISTENCE_BACKEND = "auto"

# --- Firebase / Firestore (solo si usa backend firestore o auto con credenciales) ---
# [firebase]
# project_id = "su-proyecto-gcp"
# credentials_path = "C:/ruta/segura/serviceAccount.json"

# Alternativa por variables de entorno (CI, contenedores):
# FIREBASE_PROJECT_ID
# GOOGLE_APPLICATION_CREDENTIALS o FIREBASE_CREDENTIALS_PATH
