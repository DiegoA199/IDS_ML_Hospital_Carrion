# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- Entorno y secretos (no versionar) ---
.env
.streamlit/secrets.toml
secrets.toml

