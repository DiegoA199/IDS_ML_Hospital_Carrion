# IDS-ML Hospital Carrion - variables locales de despliegue.
# Copiar como .env en cada computadora. No subir .env real al repositorio.

APP_PORT=8501
ADMINER_PORT=8080

IDSML_PERSISTENCE_BACKEND=postgres

POSTGRES_DB=idsml
POSTGRES_USER=idsml
POSTGRES_PASSWORD=idsml_dev_password
POSTGRES_PORT=5432

# Firestore es opcional y se mantiene desacoplado por repository_factory.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
